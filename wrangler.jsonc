{
  "name": "adega-digital",
  "main": "worker/index.js",
  "compatibility_date": "2025-10-08",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": [
      "/api",
      "/api/*",
      "/media/*"
    ],
    "html_handling": "auto-trailing-slash"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "adega-digital",
      "database_id": "a8d2c015-96a9-4f0c-af44-97a3d3ffefeb"
    }
  ],
  "observability": {
    "enabled": true,
    "head_sampling_rate": 0.1
  }
}
