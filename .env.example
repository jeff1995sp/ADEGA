# Variáveis de ambiente no Netlify > Site configuration > Environment variables
SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_ANON_KEY=SUA_CHAVE_PUBLICA_ANON
SUPABASE_SERVICE_ROLE_KEY=SUA_CHAVE_SECRETA_SERVICE_ROLE
TV_PASSCODE=COLOQUE-UMA-SENHA-ALEATORIA-COM-PELO-MENOS-12-CARACTERES
# Integração do gateway será feita depois. Não ative Pix/cartões online sem webhook verificado.

# Atalho admin no Netlify > Environment variables (escopo Functions).
# A senha do atalho é independente da senha do Supabase; não gravar valor real no GitHub.
ADEGA_ADMIN_PIN=SENHA_PRIVADA_ESCOLHIDA_PELO_PROPRIETARIO
# Opcional: quando houver mais de uma conta em admin_users, informe o UUID da conta desejada.
# ADEGA_ADMIN_USER_ID=UUID_DE_UMA_CONTA_ADMIN_EXISTENTE
